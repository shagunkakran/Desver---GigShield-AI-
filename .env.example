# Required — API will exit if missing
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/desver
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/desver?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/desver

# Backend port (Express)
PORT=5050

# Frontend API base (optional in local dev).
# Keep empty to use Vite proxy (/api -> VITE_API_PROXY_TARGET).
# On Vercel set to your Render URL with no trailing slash, e.g. https://gigshield-xxxx.onrender.com
# VITE_API_BASE=

# Vite dev port and proxy target (optional)
# VITE_PORT=8080
# VITE_API_PROXY_TARGET=http://127.0.0.1:5050

# Cron: evaluate triggers every N ms (server-side auto-claims). Set 0 to disable.
# On Render, prefer 0 unless you intentionally want the web instance running the timer loop.
CRON_INTERVAL_MS=120000

# Set to 0 to skip Python subprocess and use sklearn JSON dot-product in Node only
# SKLEARN_PYTHON=0

# PYTHON=py

# Auth JWT secret for login/session
AUTH_JWT_SECRET=change-me-in-production
# Comma-separated super-admin emails (can edit global system configs)
# Example: SUPER_ADMIN_EMAILS=admin@desver.com,opslead@desver.com
SUPER_ADMIN_EMAILS=

# Optional API safety limits
API_RATE_WINDOW_MS=60000
API_RATE_MAX_REQUESTS=300

# Auto-review (claim flag) thresholds
# Flag if worker fraud score >= threshold
AUTO_FLAG_FRAUD_SCORE_THRESHOLD=0.65
# Flag if payout is near per-claim cap: amount >= (perClaimLimit * ratio)
AUTO_FLAG_NEAR_LIMIT_RATIO=0.9
# Flag if claim count in last 24h crosses threshold
AUTO_FLAG_CLAIMS_24H_THRESHOLD=3
# Flag if same claim type repeats in 7d beyond threshold
AUTO_FLAG_REPEAT_TYPE_7D_THRESHOLD=4
# Set 1 to auto-flag weak-signal partial payout claims, 0 to disable
AUTO_FLAG_WEAK_SIGNAL_ENABLED=1
